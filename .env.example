# Copy to .env and fill in. .env is gitignored.

# --- System under test (Layer 1 trace generation + Layer 2 mitigation) ---
# Local model served by Ollama. Free, unlimited volume, reproducible via seed,
# and exposes token logprobs through the OpenAI-compatible endpoint below.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_OPENAI_BASE=http://127.0.0.1:11434/v1   # logprobs only available on this endpoint
SUT_MODEL=qwen3:4b-instruct
SUT_SEED=42                                    # fix for reproducible traces
SUT_TEMPERATURE=0.7                            # raise to diversify traces for DTMC learning

# Secondary SUTs for cross-model validation of the monitor
SUT_MODEL_ALT_1=llama3.2:3b
SUT_MODEL_ALT_2=gemma3:4b

# --- Judge (evaluation only: OpenFactCheck / FairEval scoring) ---
# Free-tier key from Google AI Studio (aistudio.google.com/apikey).
# This is NOT the Gemini Pro consumer subscription -- it is a separate free API key.
GEMINI_API_KEY=
JUDGE_MODEL=gemini-2.5-flash

# --- Optional paid fallback, only if free-tier judge quality proves insufficient ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: PRISM model checker binary, used for CTL checking in Layer 1.
# Leave unset to use the built-in checker in src/monitor/ctl_checker.py.
PRISM_PATH=
